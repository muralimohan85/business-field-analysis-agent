# Copy to .env (never commit it). All keys are optional: without them the demo replays the recorded snapshot.
ANTHROPIC_API_KEY=          # Claude engine and the Claude web search connectors
OPENALEX_API_KEY=           # free, required by OpenAlex since Feb 2026
PATENTSVIEW_API_KEY=        # free
NCBI_API_KEY=               # optional, raises the PubMed rate limit
OPENFDA_API_KEY=            # optional, raises the openFDA quota
BFA_CONTACT_EMAIL=          # SEC EDGAR asks for a contact address in the User-Agent
BFA_WORKSPACE=workspace     # where runs are saved
